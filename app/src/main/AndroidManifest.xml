<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= İZİNLER (Spec Bölüm 5) ================= -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34) foreground service tip izni -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 13+ (API 33) kalıcı bildirim gösterebilmek için -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Cihaz yeniden başladığında servisi otomatik ayağa kaldırmak için -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- GSM donanımı zorunlu: SMS gönderemeyen cihaza kurulmasın -->
    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <application
        android:name=".SmsGatewayApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalSmsGateway"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Ön plan servisi. specialUse tipi: kalıcı yerel HTTP+SMS köprüsü
            standart FGS tiplerinden (location/camera/dataSync vb.) hiçbirine
            girmediği için Google Play'e bu gerekçe ile bildirilir.
        -->
        <service
            android:name=".service.GatewayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local in-house SMS gateway: hosts a LAN-only HTTP endpoint that relays OTP/notification SMS through the device SIM." />
        </service>

        <!-- Cihaz açılışında servisi tekrar başlatan alıcı -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
