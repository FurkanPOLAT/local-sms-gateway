# Bu dosyayı ".env" olarak kopyalayıp gerçek değerleri girin.
# .env dosyası GİZLİDİR, git'e eklenmez (.gitignore).

# Android SMS Gateway adresi (telefonun statik IP'si)
SMS_GATEWAY_URL=http://192.168.1.50:8080

# Telefondaki uygulamada görünen X-API-KEY
SMS_GATEWAY_KEY=BURAYA_GATEWAY_ANAHTARI

# Yönetim/yasal talep uçları için admin anahtarı (güçlü seçin)
ADMIN_KEY=BURAYA_GUCLU_ADMIN_ANAHTARI

# İsteğe bağlı
SENDER_LABEL=SLNMODA
RETENTION_DAYS=730
